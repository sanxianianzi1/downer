@@ -412,6 +412,34 @@ document.addEventListener('DOMContentLoaded', () => {
         } catch (e) { Toast.show('网络错误', 'error'); }
     });
 
+    const batchMove = document.getElementById('batch-move-btn');
+    if (batchMove) batchMove.addEventListener('click', async () => {
+        const items = sel();
+        if (!items.length) return;
+        const target = await Modal.prompt('批量移动',
+            '将选中的 ' + items.length + ' 个文件移动到目标目录。输入目录路径：/ 表示根目录，/影视/2026 表示逐层目录。',
+            { placeholder: '/', okText: '移动' });
+        if (target === null) return;
+        const ids = items.map((c) => c.dataset.fileId).filter(Boolean);
+        let done = 0, fail = 0;
+        for (const id of ids) {
+            try {
+                const { ok } = await apiJson('/api/files/' + encodeURIComponent(id) + '/move', {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({ target_path: target }),
+                });
+                if (ok) done++; else fail++;
+            } catch (e) { fail++; }
+        }
+        if (fail) {
+            Toast.show('移动完成：' + done + ' 成功，' + fail + ' 失败', 'error');
+            setTimeout(() => location.reload(), 1500);
+        } else {
+            location.reload();
+        }
+    });
+
