+use std::sync::{Arc, OnceLock};
 use std::time::Duration;
 
 use reqwest::multipart;
 use serde::Serialize;
+use tokio::sync::Semaphore;
 
 use crate::constants;
 use crate::telegram::types::*;
 
+/// Process-wide upload gate shared by every `sendDocument` call, no matter which
+/// HTTP request spawned it. `TelegramService` is cloned per request, so a permit
+/// stored in the service would only serialize within one file; Telegram however
+/// rate-limits a bot's large-file uploads by accumulated volume, which is exactly
+/// what parallel multi-file uploads trigger. Defaults to one permit (strictly
+/// serial uploads); override with env `TG_SEND_GLOBAL_CONCURRENCY` (1..=4).
+fn global_upload_semaphore() -> Arc<Semaphore> {
+    static SEM: OnceLock<Arc<Semaphore>> = OnceLock::new();
+    SEM.get_or_init(|| {
+        let permits = std::env::var("TG_SEND_GLOBAL_CONCURRENCY")
+            .ok()
+            .and_then(|v| v.trim().parse::<usize>().ok())
+            .filter(|v| (1..=constants::TG_SEND_GLOBAL_CONCURRENCY_MAX).contains(v))
+            .unwrap_or(constants::TG_SEND_GLOBAL_CONCURRENCY_DEFAULT);
+        tracing::info!("Telegram 上传全局并发闸: {} 路", permits);
+        Arc::new(Semaphore::new(permits))
+    })
+    .clone()
+}
+
 /// Decide whether a Telegram error response should be retried as rate limiting,
-/// and for how many seconds. Returns `None` when the response is not a 429.
+/// and for how many seconds. Returns `None` for non-rate-limit errors.
 ///
-/// Telegram returns HTTP 429 with `{"error_code":429,"parameters":{"retry_after":N}}`.
-/// We trust either the HTTP status or the body's `error_code`, default to 3s when
-/// `retry_after` is absent, and cap the wait so a buggy/hostile value cannot stall
-/// an upload for minutes.
+/// Telegram normally signals flooding with HTTP 429 and
+/// `{"error_code":429,"parameters":{"retry_after":N}}`. For large-file uploads it
+/// also wraps the same flood error in a HTTP 400 response, e.g.
+/// `{"error_code":400,"description":"Bad Request: too Many Requests: retry after 8"}`
+/// (note the non-standard casing). Both shapes must be retried, so besides the
+/// status/error_code we also match the description text and parse the wait out of
+/// it, default to 3s when no wait is given, and cap the wait so a buggy/hostile
+/// value cannot stall an upload for minutes.
 fn retry_after_secs(status: u16, body: &serde_json::Value) -> Option<u64> {
-    let is_rate_limited = status == 429 || body["error_code"].as_i64() == Some(429);
+    let desc = body["description"].as_str().unwrap_or("");
+    let desc_lower = desc.to_ascii_lowercase();
+    let is_rate_limited = status == 429
+        || body["error_code"].as_i64() == Some(429)
+        || desc_lower.contains("too many requests")
+        || desc_lower.contains("retry after");
     if !is_rate_limited {
         return None;
     }
+    let from_desc = parse_retry_after_from_desc(desc);
     let secs = body
         .get("parameters")
         .and_then(|p| p.get("retry_after"))
         .and_then(|v| v.as_u64())
+        .or(from_desc)
         .unwrap_or(3)
         .min(60);
     Some(secs)
 }
 
+/// Extract the wait seconds from a flood description like
+/// `Bad Request: too Many Requests: retry after 8`.
+fn parse_retry_after_from_desc(desc: &str) -> Option<u64> {
+    let lower = desc.to_ascii_lowercase();
+    let idx = lower.find("retry after")?;
+    let tail = &lower[idx + "retry after".len()..];
+    let digits: &str = tail.trim_start();
+    let end = digits
+        .char_indices()
+        .find(|(_, c)| !c.is_ascii_digit())
+        .map(|(i, _)| i)
+        .unwrap_or(digits.len());
+    if end == 0 {
+        return None;
+    }
+    digits[..end].parse::<u64>().ok()
+}
