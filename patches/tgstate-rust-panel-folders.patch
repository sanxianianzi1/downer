index 45b7687..f356de1 100644
--- a/app/static/css/style.css
+++ b/app/static/css/style.css
@@ -641,3 +641,97 @@ input[type="checkbox"] {
         width: 100%;
     }
 }
+
+/* ============================================================
+   目录管理（文件管理页）
+   ============================================================ */
+
+.crumbs {
+    display: flex;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: var(--spacing-xs);
+    font-size: var(--font-size-sm);
+    color: var(--text-secondary);
+    min-height: 32px;
+}
+
+.crumbs a {
+    color: var(--accent-color);
+    text-decoration: none;
+    cursor: pointer;
+    padding: 2px 6px;
+    border-radius: var(--radius-sm);
+}
+
+.crumbs a:hover {
+    background: var(--bg-hover);
+}
+
+.crumbs .crumb-current {
+    font-weight: 600;
+    color: var(--text-primary);
+    padding: 2px 6px;
+}
+
+.crumbs .crumb-sep {
+    color: var(--text-tertiary);
+}
+
+.folder-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
+    gap: var(--spacing-sm);
+}
+
+.folder-card {
+    display: flex;
+    align-items: center;
+    gap: var(--spacing-sm);
+    padding: var(--spacing-sm) var(--spacing-md);
+    background: var(--bg-surface);
+    border: 1px solid var(--border-light);
+    border-radius: var(--radius-md);
+    box-shadow: var(--shadow-sm);
+}
+
+.folder-card:hover {
+    background: var(--bg-hover);
+}
+
+.folder-card .folder-icon {
+    flex-shrink: 0;
+    color: var(--accent-color);
+}
+
+.folder-card .folder-open {
+    flex: 1;
+    min-width: 0;
+    cursor: pointer;
+    background: none;
+    border: none;
+    padding: 0;
+    text-align: left;
+    font: inherit;
+    color: var(--text-primary);
+}
+
+.folder-card .folder-name {
+    display: block;
+    font-weight: 600;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+.folder-card .folder-meta {
+    display: block;
+    font-size: var(--font-size-sm);
+    color: var(--text-tertiary);
+}
+
+.folder-card .folder-actions {
+    display: flex;
+    gap: 2px;
+    flex-shrink: 0;
+}
