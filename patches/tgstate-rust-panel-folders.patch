+/// 从指定目录沿 parent 链向上收集，返回根 → 当前顺序的面包屑。
+/// 根节点为 { id: None, name: "根目录" }；目录不存在或链断裂时返回仅含根。
+pub fn get_folder_path(pool: &DbPool, folder_id: Option<i64>) -> Vec<Folder> {
+    let root = Folder {
+        id: 0,
+        name: "根目录".to_string(),
+        parent_id: None,
+        folder_count: 0,
+        file_count: 0,
+    };
+    let mut chain: Vec<Folder> = Vec::new();
+    let mut cur = folder_id;
+    let mut guard = 0;
+    while let Some(id) = cur {
+        guard += 1;
+        if guard > 64 {
+            // 防御异常数据成环：直接退回根视图。
+            return vec![root];
+        }
+        match get_folder(pool, id) {
+            Ok(Some(f)) => {
+                cur = f.parent_id;
+                chain.push(f);
+            }
+            _ => return vec![root],
+        }
+    }
+    let mut path = vec![root];
+    path.extend(chain.into_iter().rev());
+    path
