+/// 按 "/" 分段逐层解析目录路径，返回目标目录 id（根目录为 None）。
+/// 支持 "." 与 ".." 段；任一层目录不存在即报 404。
+async fn resolve_folder_path(state: &Arc<AppState>, raw: &str) -> Result<Option<i64>, Response> {
+    let mut cur: Option<i64> = None;
+    for seg in raw.split('/') {
+        let seg = seg.trim();
+        if seg.is_empty() || seg == "." {
+            continue;
+        }
+        if seg == ".." {
+            cur = match cur {
+                None => {
+                    return Err(
+                        http_error(StatusCode::BAD_REQUEST, "路径已到根目录之上", "bad_path")
+                            .into_response(),
+                    )
+                }
+                Some(id) => match database::get_folder(&state.db_pool, id) {
+                    Ok(Some(f)) => f.parent_id,
+                    Ok(None) => {
+                        return Err(http_error(
+                            StatusCode::NOT_FOUND,
+                            "目录不存在",
+                            "folder_not_found",
+                        )
+                        .into_response())
+                    }
+                    Err(e) => {
+                        tracing::error!("解析目录路径失败: {}", e);
+                        return Err(http_error(
+                            StatusCode::INTERNAL_SERVER_ERROR,
+                            "查询目录失败",
+                            "db_error",
+                        )
+                        .into_response());
+                    }
+                },
+            };
+            continue;
+        }
+        let (folders, _) = database::list_folder_children(&state.db_pool, cur).map_err(|e| {
+            tracing::error!("解析目录路径失败: {}", e);
+            http_error(StatusCode::INTERNAL_SERVER_ERROR, "查询目录失败", "db_error")
+                .into_response()
+        })?;
+        match folders.iter().find(|f| f.name == seg) {
+            Some(f) => cur = Some(f.id),
+            None => {
+                tracing::warn!("移动目标目录不存在: {}", seg);
+                return Err(http_error(
+                    StatusCode::NOT_FOUND,
+                    "目录不存在",
+                    "folder_not_found",
+                )
+                .into_response())
+            }
+        }
+    }
+    Ok(cur)
+}
