+++ b/src/routes/api_bot.rs
@@ -0,0 +1,587 @@
+//! Bot 管理面（/api/bot/*）。
+//!
+//! 供 bot-worker 通过 X-Bot-Key 调用，实现 Telegram 侧的目录管理命令
+//! （/ls /mkdir /mv /rename /rm /rmdir）。与面板 UI 的会话鉴权互相独立：
+//! - BOT_API_KEY 未配置 → 整面 503（fail closed）；
+//! - X-Bot-Key 不匹配 → 401；
+//! - 全局 auth 中间件把 /api/bot/ 前缀放行，由本模块自行鉴权。
+
+use std::sync::Arc;
+
+use axum::body::Body;
+use axum::extract::{Path, Query, State};
+use axum::http::{Request, StatusCode};
+use axum::middleware::{self, Next};
+use axum::response::{IntoResponse, Response};
+use axum::routing::{delete, get, patch, post};
+use axum::{Json, Router};
+use serde::Deserialize;
+use serde_json::json;
+
+use crate::auth;
+use crate::database;
+use crate::error::http_error;
+use crate::events::build_file_event;
+use crate::state::AppState;
+use crate::telegram::service::{DeleteResult, TelegramService};
+
+// ------------------------------------------------------------------
+// 鉴权
+// ------------------------------------------------------------------
+
+fn bot_api_key() -> Option<String> {
+    std::env::var("BOT_API_KEY")
+        .ok()
+        .map(|s| s.trim().to_string())
+        .filter(|s| !s.is_empty())
+}
+
+pub async fn require_bot_key(req: Request<Body>, next: Next) -> Response {
+    let Some(expected) = bot_api_key() else {
+        return (
+            StatusCode::SERVICE_UNAVAILABLE,
+            Json(json!({
+                "status": "error",
+                "code": "bot_api_disabled",
+                "message": "BOT_API_KEY 未配置，bot 管理面已禁用"
+            })),
+        )
+            .into_response();
+    };
+
+    let provided = req
+        .headers()
+        .get("x-bot-key")
+        .and_then(|v| v.to_str().ok())
+        .unwrap_or("")
+        .trim()
+        .to_string();
+
+    if provided.is_empty() || !auth::secure_compare(&provided, &expected) {
+        return (
+            StatusCode::UNAUTHORIZED,
+            Json(json!({
+                "status": "error",
+                "code": "unauthorized",
+                "message": "X-Bot-Key 校验失败"
+            })),
+        )
+            .into_response();
+    }
+
+    next.run(req).await
+}
+
+// ------------------------------------------------------------------
+// 请求体
+// ------------------------------------------------------------------
+
+#[derive(Deserialize)]
+struct ListQuery {
+    parent_id: Option<i64>,
+}
+
+#[derive(Deserialize)]
+struct CreateFolderBody {
+    name: String,
+    parent_id: Option<i64>,
+}
+
+#[derive(Deserialize)]
+struct MoveBody {
+    target_folder_id: Option<i64>,
+}
+
+#[derive(Deserialize)]
+struct RenameBody {
+    filename: String,
+}
+
+// ------------------------------------------------------------------
+// 校验
+// ------------------------------------------------------------------
+
+const NAME_MAX_LEN: usize = 255;
+
+/// 目录名 / 文件名公共校验：去除首尾空白后非空，且不允许路径分隔符。
+fn validate_name(raw: &str) -> Result<String, Response> {
+    let name = raw.trim();
+    if name.is_empty() {
+        return Err((
+            StatusCode::BAD_REQUEST,
+            Json(json!({
+                "status": "error",
+                "code": "invalid_name",
+                "message": "名称不能为空"
+            })),
+        )
+            .into_response());
+    }
+    if name.contains('/') || name.contains('\\') {
+        return Err((
+            StatusCode::BAD_REQUEST,
+            Json(json!({
+                "status": "error",
+                "code": "invalid_name",
+                "message": "名称不能包含 / 或 \\"
+            })),
+        )
+            .into_response());
+    }
+    if name.chars().count() > NAME_MAX_LEN {
+        return Err((
+            StatusCode::BAD_REQUEST,
+            Json(json!({
+                "status": "error",
+                "code": "invalid_name",
+                "message": format!("名称不能超过 {} 个字符", NAME_MAX_LEN)
+            })),
+        )
+            .into_response());
+    }
+    Ok(name.to_string())
+}
+
+// ------------------------------------------------------------------
+// Telegram 服务（与 api_files 相同的构造逻辑）
+// ------------------------------------------------------------------
+
+fn get_telegram_service(state: &AppState) -> Result<TelegramService, Response> {
+    let app_settings = crate::config::get_app_settings(&state.settings, &state.db_pool);
+    let token = app_settings
+        .get("BOT_TOKEN")
+        .and_then(|v| v.as_deref())
+        .unwrap_or("")
+        .to_string();
+    let channel = app_settings
+        .get("CHANNEL_NAME")
+        .and_then(|v| v.as_deref())
+        .unwrap_or("")
+        .to_string();
+
+    if token.is_empty() || channel.is_empty() {
+        return Err(http_error(
+            StatusCode::SERVICE_UNAVAILABLE,
+            "Bot 未配置",
+            "bot_not_configured",
+        )
+        .into_response());
+    }
+
+    Ok(TelegramService::new(
+        token,
+        channel,
+        state.http_client.clone(),
+    ))
+}
+
+fn broadcast_delete(state: &AppState, file_id: &str) {
+    let ev = build_file_event("delete", file_id, None, None, None, None);
+    state.event_bus.publish(serde_json::to_string(&ev).unwrap_or_default());
+}
+
+// ------------------------------------------------------------------
+// Handlers
+// ------------------------------------------------------------------
+
+async fn list_folder(
+    State(state): State<Arc<AppState>>,
+    Query(q): Query<ListQuery>,
+) -> Response {
+    match database::list_folder_children(&state.db_pool, q.parent_id) {
+        Ok((folders, files)) => Json(json!({ "folders": folders, "files": files })).into_response(),
+        Err(e) => {
+            tracing::error!("bot 列目录失败: {}", e);
+            http_error(
+                StatusCode::INTERNAL_SERVER_ERROR,
+                "查询目录失败",
+                "db_error",
+            )
+            .into_response()
+        }
+    }
+}
+
+async fn create_folder(
+    State(state): State<Arc<AppState>>,
+    Json(body): Json<CreateFolderBody>,
+) -> Response {
+    let name = match validate_name(&body.name) {
+        Ok(n) => n,
+        Err(resp) => return resp,
+    };
+
+    if let Some(pid) = body.parent_id {
+        match database::get_folder(&state.db_pool, pid) {
+            Ok(Some(_)) => {}
+            Ok(None) => {
+                return http_error(
+                    StatusCode::NOT_FOUND,
+                    "父目录不存在",
+                    "folder_not_found",
+                )
+                .into_response()
+            }
+            Err(e) => {
+                tracing::error!("bot 查询父目录失败: {}", e);
+                return http_error(
+                    StatusCode::INTERNAL_SERVER_ERROR,
+                    "查询父目录失败",
+                    "db_error",
+                )
+                .into_response();
+            }
+        }
+    }
+
+    match database::create_folder(&state.db_pool, &name, body.parent_id) {
+        Ok(f) => Json(json!({
+            "status": "ok",
+            "id": f.id,
+            "name": f.name,
+            "parent_id": f.parent_id,
+        }))
+        .into_response(),
+        Err(e) => {
+            tracing::error!("bot 创建目录失败: {}", e);
+            http_error(
+                StatusCode::INTERNAL_SERVER_ERROR,
+                "创建目录失败",
+                "db_error",
+            )
+            .into_response()
+        }
+    }
+}
+
+async fn rename_folder(
+    State(state): State<Arc<AppState>>,
+    Path(id): Path<i64>,
+    Json(body): Json<CreateFolderBody>,
+) -> Response {
+    let name = match validate_name(&body.name) {
+        Ok(n) => n,
+        Err(resp) => return resp,
+    };
+    match database::get_folder(&state.db_pool, id) {
+        Ok(Some(_)) => {}
+        Ok(None) => {
+            return http_error(StatusCode::NOT_FOUND, "目录不存在", "folder_not_found")
+                .into_response()
+        }
+        Err(e) => {
+            tracing::error!("bot 查询目录失败: {}", e);
+            return http_error(StatusCode::INTERNAL_SERVER_ERROR, "查询目录失败", "db_error")
+                .into_response();
+        }
+    }
+    match database::rename_folder(&state.db_pool, id, &name) {
+        Ok(_) => Json(json!({ "status": "ok", "id": id, "name": name })).into_response(),
+        Err(e) => {
+            tracing::error!("bot 目录改名失败: {}", e);
+            http_error(StatusCode::INTERNAL_SERVER_ERROR, "目录改名失败", "db_error")
+                .into_response()
+        }
+    }
+}
+
+/// 级联删除目录：递归 CTE 收集子树 → 逐文件走与面板删除相同的
+/// 「TG 删主消息 + 分块 → DB 删行」流程 → 删除全部目录行。
+/// 主消息删除失败的文件移回根目录并列入 failed_files，便于稍后重试。
+async fn delete_folder_cascade(
+    State(state): State<Arc<AppState>>,
+    Path(id): Path<i64>,
+) -> Response {
+    let tg = match get_telegram_service(&state) {
+        Ok(t) => t,
+        Err(resp) => return resp,
+    };
+
+    match database::get_folder(&state.db_pool, id) {
+        Ok(Some(_)) => {}
+        Ok(None) => {
+            return http_error(StatusCode::NOT_FOUND, "目录不存在", "folder_not_found")
+                .into_response()
+        }
+        Err(e) => {
+            tracing::error!("bot 查询目录失败: {}", e);
+            return http_error(StatusCode::INTERNAL_SERVER_ERROR, "查询目录失败", "db_error")
+                .into_response();
+        }
+    }
+
+    let (folder_ids, files) = match database::collect_subtree(&state.db_pool, id) {
+        Ok(x) => x,
+        Err(e) => {
+            tracing::error!("bot 收集目录子树失败: {}", e);
+            return http_error(StatusCode::INTERNAL_SERVER_ERROR, "查询目录失败", "db_error")
+                .into_response();
+        }
+    };
+
+    let mut files_deleted: u64 = 0;
+    let mut bytes_freed: i64 = 0;
+    let mut failed_files: Vec<serde_json::Value> = Vec::new();
+    let mut failed_chunks: Vec<String> = Vec::new();
+
+    for f in &files {
+        let result = match tokio::time::timeout(
+            std::time::Duration::from_secs(30),
+            tg.delete_file_with_chunks(&f.file_id),
+        )
+        .await
+        {
+            Ok(r) => r,
+            Err(_) => DeleteResult {
+                status: "timeout".into(),
+                main_file_id: f.file_id.clone(),
+                deleted_chunks: vec![],
+                failed_chunks: vec![],
+                main_message_deleted: false,
+                main_delete_reason: "timeout".into(),
+                is_manifest: false,
+                reason: "telegram delete timeout".into(),
+            },
+        };
+
+        if result.main_message_deleted {
+            if database::delete_file_metadata(&state.db_pool, &f.file_id).unwrap_or(false) {
+                files_deleted += 1;
+                bytes_freed += f.filesize;
+                broadcast_delete(&state, &f.file_id);
+            }
+            failed_chunks.extend(result.failed_chunks.iter().cloned());
+        } else {
+            // 保底：文件行保留，移回根目录，避免留下指向已不存在目录的行。
+            let _ = database::set_file_folder(&state.db_pool, &f.file_id, None);
+            failed_files.push(json!({
+                "short_id": f.short_id,
+                "filename": f.filename,
+                "reason": result.reason,
+            }));
+        }
+    }
+
+    match database::delete_folders_by_ids(&state.db_pool, &folder_ids) {
+        Ok(_) => {}
+        Err(e) => {
+            tracing::error!("bot 删除目录行失败: {}", e);
+            return http_error(StatusCode::INTERNAL_SERVER_ERROR, "删除目录失败", "db_error")
+                .into_response();
+        }
+    }
+
+    tracing::info!(
+        "bot 级联删除目录 id={}: 目录 {} 个，文件 {} 个，释放 {} 字节",
+        id,
+        folder_ids.len(),
+        files_deleted,
+        bytes_freed
+    );
+
+    Json(json!({
+        "status": "ok",
+        "folders_deleted": folder_ids.len(),
+        "files_deleted": files_deleted,
+        "bytes_freed": bytes_freed,
+        "failed_files": failed_files,
+        "failed_chunks": failed_chunks,
+    }))
+    .into_response()
+}
+
+async fn move_file(
+    State(state): State<Arc<AppState>>,
+    Path(file_id): Path<String>,
+    Json(body): Json<MoveBody>,
+) -> Response {
+    if let Some(pid) = body.target_folder_id {
+        match database::get_folder(&state.db_pool, pid) {
+            Ok(Some(_)) => {}
+            Ok(None) => {
+                return http_error(
+                    StatusCode::NOT_FOUND,
+                    "目标目录不存在",
+                    "target_folder_not_found",
+                )
+                .into_response()
+            }
+            Err(e) => {
+                tracing::error!("bot 查询目标目录失败: {}", e);
+                return http_error(
+                    StatusCode::INTERNAL_SERVER_ERROR,
+                    "查询目标目录失败",
+                    "db_error",
+                )
+                .into_response();
+            }
+        }
+    }
+
+    let meta = match database::get_file_by_id(&state.db_pool, &file_id) {
+        Ok(Some(m)) => m,
+        Ok(None) => {
+            return http_error(StatusCode::NOT_FOUND, "文件不存在", "file_not_found")
+                .into_response()
+        }
+        Err(e) => {
+            tracing::error!("bot 查询文件失败: {}", e);
+            return http_error(StatusCode::INTERNAL_SERVER_ERROR, "查询文件失败", "db_error")
+                .into_response();
+        }
+    };
+
+    match database::set_file_folder(&state.db_pool, &file_id, body.target_folder_id) {
+        Ok(true) => Json(json!({
+            "status": "ok",
+            "short_id": meta.short_id,
+            "filename": meta.filename,
+            "folder_id": body.target_folder_id,
+        }))
+        .into_response(),
+        Ok(false) => {
+            http_error(StatusCode::NOT_FOUND, "文件不存在", "file_not_found").into_response()
+        }
+        Err(e) => {
+            tracing::error!("bot 移动文件失败: {}", e);
+            http_error(StatusCode::INTERNAL_SERVER_ERROR, "移动文件失败", "db_error")
+                .into_response()
+        }
+    }
+}
+
+async fn rename_file(
+    State(state): State<Arc<AppState>>,
+    Path(file_id): Path<String>,
+    Json(body): Json<RenameBody>,
+) -> Response {
+    let new_name = match validate_name(&body.filename) {
+        Ok(n) => n,
+        Err(resp) => return resp,
+    };
+
+    match database::rename_file_metadata(&state.db_pool, &file_id, &new_name) {
+        Ok(true) => {
+            let short_id = database::get_file_by_id(&state.db_pool, &file_id)
+                .ok()
+                .flatten()
+                .and_then(|m| m.short_id);
+            Json(json!({
+                "status": "ok",
+                "filename": new_name,
+                "short_id": short_id,
+            }))
+            .into_response()
+        }
+        Ok(false) => {
+            http_error(StatusCode::NOT_FOUND, "文件不存在", "file_not_found").into_response()
+        }
+        Err(e) => {
+            tracing::error!("bot 文件改名失败: {}", e);
+            http_error(StatusCode::INTERNAL_SERVER_ERROR, "文件改名失败", "db_error")
+                .into_response()
+        }
+    }
+}
+
+/// 与面板 DELETE /api/files/:file_id 相同的删除流程（主消息 + 分块 + DB 行）。
+async fn delete_file_bot(
+    State(state): State<Arc<AppState>>,
+    Path(file_id): Path<String>,
+) -> Response {
+    let tg = match get_telegram_service(&state) {
+        Ok(t) => t,
+        Err(resp) => return resp,
+    };
+
+    let tg_id = match database::get_file_by_id(&state.db_pool, &file_id) {
+        Ok(Some(f)) => f.file_id.clone(),
+        Ok(None) => file_id.clone(),
+        Err(e) => {
+            tracing::error!("删除前查询文件失败: {}", e);
+            return http_error(StatusCode::INTERNAL_SERVER_ERROR, "查询文件失败", "db_error")
+                .into_response();
+        }
+    };
+
+    let result = match tokio::time::timeout(
+        std::time::Duration::from_secs(30),
+        tg.delete_file_with_chunks(&tg_id),
+    )
+    .await
+    {
+        Ok(r) => r,
+        Err(_) => DeleteResult {
+            status: "timeout".into(),
+            main_file_id: tg_id.clone(),
+            deleted_chunks: vec![],
+            failed_chunks: vec![],
+            main_message_deleted: false,
+            main_delete_reason: "timeout".into(),
+            is_manifest: false,
+            reason: "telegram delete timeout".into(),
+        },
+    };
+
+    let db_deleted = if result.main_message_deleted {
+        database::delete_file_metadata(&state.db_pool, &file_id).unwrap_or(false)
+    } else {
+        false
+    };
+    if db_deleted {
+        broadcast_delete(&state, &file_id);
+    }
+
+    if result.main_message_deleted {
+        let db_status = if db_deleted { "deleted" } else { "not_found_in_db" };
+        if result.failed_chunks.is_empty() {
+            return Json(json!({
+                "status": "ok",
+                "message": format!("文件 {} 已删除。", file_id),
+                "details": { "db": db_status, "tg": result }
+            }))
+            .into_response();
+        }
+        return (
+            StatusCode::INTERNAL_SERVER_ERROR,
+            Json(json!({
+                "status": "error",
+                "code": "partial_failure",
+                "message": "主文件已删，但部分分块删除失败",
+                "details": { "db": db_status, "tg": result }
+            })),
+        )
+            .into_response();
+    }
+
+    (
+        StatusCode::BAD_GATEWAY,
+        Json(json!({
+            "status": "error",
+            "code": "delete_failed",
+            "message": format!("Telegram 删除失败：{}", result.reason),
+            "details": { "tg": result }
+        })),
+    )
+        .into_response()
+}
+
+// ------------------------------------------------------------------
+// 路由
+// ------------------------------------------------------------------
+
+pub fn router() -> Router<Arc<AppState>> {
+    Router::new()
+        .route(
+            "/api/bot/folders",
+            get(list_folder).post(create_folder),
+        )
+        .route("/api/bot/folders/:id", delete(delete_folder_cascade))
+        .route("/api/bot/folders/:id/rename", post(rename_folder))
+        .route("/api/bot/files/:file_id/move", post(move_file))
+        .route(
+            "/api/bot/files/:file_id",
+            patch(rename_file).delete(delete_file_bot),
+        )
+        .layer(middleware::from_fn(require_bot_key))
+}
