+// ------------------------------------------------------------------
+// 运行期凭据（夸克直链 Cookie）：bot /setcookie 写入，workflow 取用
+// ------------------------------------------------------------------
+
+#[derive(Deserialize)]
+struct QuarkCookieBody {
+    cookie: String,
+}
+
+const KV_QUARK_COOKIE: &str = "quark_cookie";
+const QUARK_COOKIE_MAX_LEN: usize = 8192;
+
+async fn get_quark_cookie(State(state): State<Arc<AppState>>) -> Response {
+    match database::kv_get(&state.db_pool, KV_QUARK_COOKIE) {
+        Ok(v) => Json(json!({ "cookie": v })).into_response(),
+        Err(e) => {
+            tracing::error!("bot 读取 Cookie 失败: {}", e);
+            http_error(StatusCode::INTERNAL_SERVER_ERROR, "读取失败", "db_error")
+                .into_response()
+        }
+    }
+}
+
+async fn set_quark_cookie(
+    State(state): State<Arc<AppState>>,
+    Json(body): Json<QuarkCookieBody>,
+) -> Response {
+    let cookie = body.cookie.trim().to_string();
+    if cookie.len() > QUARK_COOKIE_MAX_LEN {
+        return http_error(
+            StatusCode::BAD_REQUEST,
+            "Cookie 过长",
+            "cookie_too_long",
+        )
+        .into_response();
+    }
+    // 空值 = 清除；其余原样存（cookie 格式由上游保证，服务端不强校验）
+    match database::kv_set(&state.db_pool, KV_QUARK_COOKIE, &cookie) {
+        Ok(()) => {
+            let action = if cookie.is_empty() { "已清除" } else { "已更新" };
+            tracing::info!("bot 面 Quark Cookie {}", action);
+            Json(json!({
+                "status": "ok",
+                "message": format!("Cookie {}", action),
+                "cleared": cookie.is_empty(),
+            }))
+            .into_response()
+        }
+        Err(e) => {
+            tracing::error!("bot 写入 Cookie 失败: {}", e);
+            http_error(StatusCode::INTERNAL_SERVER_ERROR, "写入失败", "db_error")
+                .into_response()
+        }
+    }
+}
